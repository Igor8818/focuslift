# ─── FocusLift Backend API (Java 21 + Spring Boot 3 + PostgreSQL) ─────────
# Em emulador Android: http://10.0.2.2:8080
# Em emulador iOS ou Web: http://localhost:8080
# Em celular físico na mesma rede Wi-Fi: http://192.168.x.x:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# ─── RevenueCat (Pagamentos In-App: Google Play Billing & Apple StoreKit) ────
# Obtenha em https://app.revenuecat.com -> Project Settings -> API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
