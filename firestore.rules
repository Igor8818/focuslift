rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Verifica se o usuário possui assinatura PRO validada no servidor
    // (via Custom Claims do Firebase Auth preenchidos por Webhook do RevenueCat
    // ou documento protegido em /subscriptions/{userId} gravado apenas via Admin SDK).
    function hasServerVerifiedPro(userId) {
      return request.auth.token.pro == true
        || (exists(/databases/$(database)/documents/subscriptions/$(userId))
            && get(/databases/$(database)/documents/subscriptions/$(userId)).data.active == true);
    }

    function isValidCollection(col) {
      return col in [
        'workouts',
        'routines',
        'habits',
        'customHabits',
        'customHabitLogs',
        'bodyweight'
      ];
    }

    // Documento de status de assinatura: leitura pelo próprio dono, escrita EXCLUSIVA pelo backend (Webhook / Admin SDK)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Regra de Isolamento por Usuário (Row-Level Security) + Whitelist de Subcoleções:
    // Cada usuário autenticado só pode ler e escrever nas coleções oficiais da sua própria árvore /users/{userId}/{collection}/{docId}
    match /users/{userId}/{collection}/{docId} {
      allow read, delete: if isOwner(userId) && isValidCollection(collection);
      allow create, update: if isOwner(userId)
        && isValidCollection(collection)
        && request.resource.data.userId == userId
        && request.resource.data.keys().size() <= 20;
    }

    // Bloqueia qualquer acesso fora do padrão autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
